; Custom cargo-packager 0.11.8 messages; standard pages use the NSIS translation (Brazil).
LangString addOrReinstall ${LANG_PORTUGUESEBR} "Adicionar componentes / reinstalar"
LangString alreadyInstalled ${LANG_PORTUGUESEBR} "Já instalado"
LangString alreadyInstalledLong ${LANG_PORTUGUESEBR} "${PRODUCTNAME} ${VERSION} já está instalado. Escolha uma ação e clique em Avançar."
LangString appRunning ${LANG_PORTUGUESEBR} "${PRODUCTNAME} está em execução. Feche o aplicativo e tente novamente."
LangString appRunningOkKill ${LANG_PORTUGUESEBR} "${PRODUCTNAME} está em execução.$\nClique em OK para fechar o aplicativo."
LangString chooseMaintenanceOption ${LANG_PORTUGUESEBR} "Escolha a ação de manutenção desejada."
LangString choowHowToInstall ${LANG_PORTUGUESEBR} "Escolha como instalar ${PRODUCTNAME}."
LangString createDesktop ${LANG_PORTUGUESEBR} "Criar atalho na área de trabalho"
LangString dontUninstall ${LANG_PORTUGUESEBR} "Não desinstalar"
LangString dontUninstallDowngrade ${LANG_PORTUGUESEBR} "Não desinstalar (uma versão anterior exige primeiro a desinstalação)"
LangString failedToKillApp ${LANG_PORTUGUESEBR} "Não foi possível fechar ${PRODUCTNAME}. Feche o aplicativo e tente novamente."
LangString installingWebview2 ${LANG_PORTUGUESEBR} "Instalando WebView2..."
LangString newerVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão mais recente de ${PRODUCTNAME} já está instalada. Não é recomendável instalar uma versão anterior. Desinstale primeiro a versão atual se desejar continuar. Escolha uma ação e clique em Avançar."
LangString older ${LANG_PORTUGUESEBR} "anterior"
LangString olderOrUnknownVersionInstalled ${LANG_PORTUGUESEBR} "Uma versão $R4 de ${PRODUCTNAME} está instalada. É recomendável desinstalá-la primeiro. Escolha uma ação e clique em Avançar."
LangString silentDowngrades ${LANG_PORTUGUESEBR} "A instalação silenciosa de versões anteriores está desativada. Use a instalação gráfica.$\n"
LangString unableToUninstall ${LANG_PORTUGUESEBR} "Não é possível desinstalar."
LangString uninstallApp ${LANG_PORTUGUESEBR} "Desinstalar ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_PORTUGUESEBR} "Desinstalar antes de instalar"
LangString unknown ${LANG_PORTUGUESEBR} "desconhecida"
LangString deleteAppData ${LANG_PORTUGUESEBR} "Excluir os dados do aplicativo"
